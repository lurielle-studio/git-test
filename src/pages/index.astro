---
import Layout from '../components/Layout.astro';

// Navigation links for smooth scroll
const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#how-it-works', label: 'How It Works' },
  { href: '#pricing', label: 'Pricing' },
];
---

<Layout title="Cortana - AI Teammates for Solo Founders" description="Multi-agent AI coordination for solo founders and small startups. Ship faster with visible agent collaboration and human oversight.">
  <!-- Hero Section -->
  <section id="hero" class="bg-gradient-to-b from-primary-50 to-white pt-32 pb-20 md:pt-40 md:pb-32">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
          Ship faster with AI<br class="hidden md:block" />
          <span class="text-primary-600">teammates</span>
        </h1>
        <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
          Multiple AI agents collaborate in visible conversations. Delegate complex projects. 
          Stay in control with approval gates for every action.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
          <a 
            href="https://github.com/lurielle-studio/cortana" 
            class="btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2"
          >
            Start Building Free
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a 
            href="#how-it-works" 
            class="btn-secondary w-full sm:w-auto"
          >
            See How It Works
          </a>
        </div>
        <p class="text-sm text-gray-500 flex items-center justify-center gap-4">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Open Source
          </span>
          <span>•</span>
          <span>1,810+ Tests</span>
          <span>•</span>
          <span>MIT License</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section id="problem" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Building a startup is overwhelming
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          You're juggling strategy, design, development, and ops. 
          It's too much for one person.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Pain Point 1 -->
        <div class="p-8 bg-red-50 rounded-xl border border-red-100">
          <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600">
              <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
              <path d="M12 2a10 10 0 0 1 10 10"></path>
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Wearing all the hats is exhausting</h3>
          <p class="text-gray-600">Strategy Monday, design Tuesday, development Wednesday. You're constantly context-switching and nothing gets the attention it deserves.</p>
        </div>
        
        <!-- Pain Point 2 -->
        <div class="p-8 bg-orange-50 rounded-xl border border-orange-100">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-600">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Getting stuck on decisions slows you down</h3>
          <p class="text-gray-600">No one to bounce ideas off. You second-guess every decision. Days turn into weeks while you're paralyzed by analysis.</p>
        </div>
        
        <!-- Pain Point 3 -->
        <div class="p-8 bg-orange-50 rounded-xl border border-orange-100">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-600">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Missing perspective leads to blind spots</h3>
          <p class="text-gray-600">You don't know what you don't know. Critical issues slip through. Technical debt accumulates. User experience suffers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution / How It Works Section -->
  <section id="how-it-works" class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Your AI team, coordinated and visible
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Specialized agents collaborate in shared threads. You approve every action. 
          Ship faster without losing control.
        </p>
      </div>
      
      <!-- 3-Step Process -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-16">
        <!-- Step 1 -->
        <div class="relative">
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 h-full">
            <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-4">
              <span class="text-white font-bold text-lg">1</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">Create your channel</h3>
            <p class="text-gray-600">Activate AI teammates (CEO, CTO, Developer, DevOps) in a shared conversation thread. Each agent has specialized skills and tools.</p>
          </div>
          <!-- Connector line (desktop only) -->
          <div class="hidden md:block absolute top-12 -right-4 w-8 h-0.5 bg-gray-300"></div>
        </div>
        
        <!-- Step 2 -->
        <div class="relative">
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 h-full">
            <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-4">
              <span class="text-white font-bold text-lg">2</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">Ask & collaborate</h3>
            <p class="text-gray-600">@mention agents to ask questions, propose tasks, or get feedback. Watch them coordinate in real-time with full visibility.</p>
          </div>
          <!-- Connector line (desktop only) -->
          <div class="hidden md:block absolute top-12 -right-4 w-8 h-0.5 bg-gray-300"></div>
        </div>
        
        <!-- Step 3 -->
        <div>
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 h-full">
            <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-4">
              <span class="text-white font-bold text-lg">3</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">Review & approve</h3>
            <p class="text-gray-600">Every agent action requires your approval. Review tasks in the Kanban board, then let workers execute with your OK.</p>
          </div>
        </div>
      </div>
      
      <!-- Demo Conversation Example -->
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
          <div class="bg-gray-900 px-4 py-3 flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="ml-2 text-gray-400 text-sm">thread: new-feature-chat</span>
          </div>
          <div class="p-6 space-y-4">
            <!-- User Message -->
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-medium text-gray-600">You</span>
              </div>
              <div class="flex-1">
                <div class="bg-gray-50 rounded-lg p-3">
                  <p class="text-gray-900">@ceo Let's build a user authentication feature with email login. What's the approach?</p>
                </div>
              </div>
            </div>
            
            <!-- CEO Agent Response -->
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-medium text-blue-600">CEO</span>
              </div>
              <div class="flex-1">
                <div class="bg-blue-50 rounded-lg p-3 border border-blue-100">
                  <p class="text-gray-900 mb-2">I'll break this down into tasks:</p>
                  <ul class="list-disc list-inside text-gray-700 space-y-1">
                    <li>Database schema for users table</li>
                    <li>Password hashing with bcrypt</li>
                    <li>Email verification flow</li>
                    <li>Session management</li>
                  </ul>
                  <p class="text-gray-900 mt-2">@cto Can you review the technical approach?</p>
                </div>
              </div>
            </div>
            
            <!-- CTO Agent Response -->
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-medium text-purple-600">CTO</span>
              </div>
              <div class="flex-1">
                <div class="bg-purple-50 rounded-lg p-3 border border-purple-100">
                  <p class="text-gray-900 mb-2">Approach looks solid. Recommendations:</p>
                  <ul class="list-disc list-inside text-gray-700 space-y-1">
                    <li>Use Phoenix Token for email verification</li>
                    <li>Implement rate limiting on login endpoint</li>
                    <li>Add unique index on email field</li>
                  </ul>
                  <p class="text-gray-900 mt-2">@developer Ready to implement?</p>
                </div>
              </div>
            </div>
            
            <!-- Task Proposal -->
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-medium text-green-600">Dev</span>
              </div>
              <div class="flex-1">
                <div class="bg-green-50 rounded-lg p-3 border border-green-100">
                  <p class="text-gray-900 mb-2">📋 <strong>Task Proposal: User Auth Implementation</strong></p>
                  <p class="text-gray-700">Create users table, implement registration/login endpoints, add email verification</p>
                  <p class="text-gray-700 mt-2"><strong>Estimate:</strong> 4 tokens</p>
                  <div class="mt-3 flex gap-2">
                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">✓ Pending Approval</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-gray-500 text-sm mt-4">
          ↑ Real conversation flow. Agents collaborate visibly. You approve every task.
        </p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Everything you need to ship
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Built for solo founders and small teams who need to move fast without breaking things.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Multi-Agent Coordination -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Multi-Agent Coordination</h3>
          <p class="text-gray-600">Specialized agents collaborate in shared conversation threads—no hidden orchestration layers.</p>
        </div>
        
        <!-- Feature 2: Human Approval Gate -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Human Approval Gate</h3>
          <p class="text-gray-600">Every agent action requires your review and approval. Nothing happens without your OK.</p>
        </div>
        
        <!-- Feature 3: Turn Coordinator -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Patented Turn Coordinator</h3>
          <p class="text-gray-600">Sequential dispatch pattern ensures agents take turns efficiently without conflicts.</p>
        </div>
        
        <!-- Feature 4: Task Board -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Task Board</h3>
          <p class="text-gray-600">Visual Kanban board shows proposed, approved, and completed work. Filter, approve, track progress.</p>
        </div>
        
        <!-- Feature 5: Context Memory -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
              <path d="M12 2a10 10 0 0 1 10 10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Context Memory</h3>
          <p class="text-gray-600">Three-level observation memory captures decisions across conversations. Agents remember everything.</p>
        </div>
        
        <!-- Feature 6: MCP Integration -->
        <div class="p-6 bg-gray-50 rounded-xl hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 1v6m0 6v6M1 12h6m6 0h6"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">MCP Integration</h3>
          <p class="text-gray-600">Connect GitHub, Slack, Stripe and more. Agents discover and use real tools securely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof Section -->
  <section id="social-proof" class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Built for solo founders, by builders
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We understand the grind because we've been there. Cortana is the tool we wish we had.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        <!-- Metric 1 -->
        <div class="text-center p-6">
          <div class="text-4xl font-bold text-primary-600 mb-2">1,810+</div>
          <div class="text-gray-600">Passing Tests</div>
        </div>
        
        <!-- Metric 2 -->
        <div class="text-center p-6">
          <div class="text-4xl font-bold text-primary-600 mb-2">18</div>
          <div class="text-gray-600">Development Phases</div>
        </div>
        
        <!-- Metric 3 -->
        <div class="text-center p-6">
          <div class="text-4xl font-bold text-primary-600 mb-2">100%</div>
          <div class="text-gray-600">Open Source</div>
        </div>
      </div>
      
      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-8">
        <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-gray-200">
          <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span class="text-gray-700 font-medium">Open Source on GitHub</span>
        </div>
        
        <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-gray-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <span class="text-gray-700 font-medium">MIT License</span>
        </div>
        
        <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-gray-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span class="text-gray-700 font-medium">Production-Ready Code</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Simple pricing for builders
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Start free. Upgrade when you need more. No hidden fees.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Free Tier -->
        <div class="border border-gray-200 rounded-xl p-8 hover:shadow-lg transition-shadow">
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-gray-900">Free</h3>
            <p class="text-gray-600 mt-1">Perfect for learning and side projects</p>
          </div>
          <div class="mb-6">
            <span class="text-4xl font-bold text-gray-900">$0</span>
            <span class="text-gray-600">/month</span>
          </div>
